include THIRD_PARTY_NOTICES.md AGENTS.md
recursive-include scripts *.py *.json
recursive-include docs *.md *.json *.toml
include docs/diagrams/flujo-roclec.svg docs/evaluation/evidence.sha256
prune docs/definition/evidence
prune docs/evaluation/evidence
prune docs/implementation/evidence
recursive-include viewer-ui/src *
include viewer-ui/package.json viewer-ui/package-lock.json viewer-ui/tsconfig.json viewer-ui/vite.config.ts viewer-ui/index.html
prune viewer-ui/node_modules
